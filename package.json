{
  "name": "opencli-plugin-fb-autopost",
  "version": "0.1.0",
  "description": "OpenCLI plugin for Facebook group and personal profile posts with explicit-confirm publishing.",
  "license": "Apache-2.0",
  "author": "Ang Jing Kang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenotoriousmrkrabs/opencli-plugin-fb-autopost.git"
  },
  "homepage": "https://github.com/thenotoriousmrkrabs/opencli-plugin-fb-autopost#readme",
  "bugs": {
    "url": "https://github.com/thenotoriousmrkrabs/opencli-plugin-fb-autopost/issues"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "worker:dry-run": "node worker/posting-worker.js --job examples/job.dry-run.json",
    "worker:confirm": "node worker/posting-worker.js --job examples/job.live.json --confirm true",
    "package": "node scripts/package-local.js",
    "package:local": "node scripts/package-local.js",
    "test": "vitest run --config tests/vitest.config.js"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "keywords": [
    "opencli",
    "facebook",
    "plugin",
    "hermes"
  ],
  "devDependencies": {
    "@jackwener/opencli": "2.0.0",
    "vitest": "4.1.8"
  }
}
